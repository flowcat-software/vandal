{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vandal",
  "version": "../package.json",
  "identifier": "com.vandal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://capture.localhost; img-src 'self' blob: data: http://capture.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRjNENTJFNzVGQzI1REIKUldUYkpmeDFMdFh6ZnNtbWRsa1FiNlJ6c01zU3ZvNnhQY3hRM1Q0SS9PQ2hJd0lDNVB0dC9UeE4K",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Flowcat Software",
    "copyright": "Copyright © 2026 Flowcat Software",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Fast, free screen capture and markup",
    "longDescription": "A fast, free screen capture and markup tool for Windows. Press a shortcut, select an area, draw on it, and it's on your clipboard. Every tool remembers your settings, every picker can be tailored to your workflow, and almost everything has a keyboard shortcut.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "./windows/nsis-header.bmp",
        "sidebarImage": "./windows/nsis-sidebar.bmp"
      }
    }
  }
}
