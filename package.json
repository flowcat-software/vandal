{
  "name": "vandal",
  "private": true,
  "version": "0.3.0-beta.13",
  "description": "Fast, free screen capture and markup for Windows",
  "author": "Richard Podsada",
  "license": "GPL-3.0-or-later",
  "repository": "github:rpodsada/vandal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "security": "npm audit --omit=dev && cargo deny --manifest-path src-tauri/Cargo.toml check advisories sources",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "release:bump": "node scripts/release.mjs bump",
    "build:local": "node scripts/build-local.mjs",
    "ext:build": "tsc -p extension/chrome && vite build -c extension/chrome/vite.config.ts && vite build -c extension/chrome/vite.content.config.ts",
    "ext:dev": "node scripts/ext-dev.mjs",
    "ext:zip": "npm run ext:build && node scripts/ext-zip.mjs",
    "ext:host-dev": "node scripts/ext-host-dev.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "konva": "^10.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
